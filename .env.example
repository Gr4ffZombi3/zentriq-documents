FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-value

# MariaDB
# MARIADB_ROOT_PASSWORD/DATABASE/USER/PASSWORD werden NUR von docker-compose.yml gelesen
# (lokale Dev-DB im Container). Auf dem Produktionsserver (natives MariaDB via
# deploy/install.sh) ist ausschliesslich DATABASE_URL relevant - die einzige Variable,
# die config.py tatsaechlich liest.
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=zentriq_documents
MARIADB_USER=zentriq
MARIADB_PASSWORD=change-me
DATABASE_URL=mysql+pymysql://zentriq:change-me@localhost:3306/zentriq_documents

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=
# ACHTUNG: gilt fuer ALLE KI-Funktionen inkl. Leipziger-Liste-Extraktion. Leer = OpenAI-Standard.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MAILBOX_CLASSIFICATION_MODEL=gpt-4o
# Optional: abweichender Endpoint NUR fuer Mailbox-Transkription/-Klassifizierung.
MAILBOX_OPENAI_BASE_URL=

# Placetel-Mailbox / IMAP (zunaechst Dry Run; Muster aus einer echten Placetel-Mail uebernehmen)
PLACETEL_MAILBOX_ENABLED=false
PLACETEL_TENANT_ID=
PLACETEL_IMAP_HOST=
PLACETEL_IMAP_PORT=993
PLACETEL_IMAP_USERNAME=
PLACETEL_IMAP_PASSWORD=
PLACETEL_IMAP_FOLDER=INBOX
PLACETEL_IMAP_SSL=true
PLACETEL_SENDER_PATTERNS=
PLACETEL_SUBJECT_PATTERNS=
PLACETEL_CALLER_ID_HEADERS=X-Caller-ID,X-Caller-Number,Caller-Number
PLACETEL_POLL_INTERVAL_SECONDS=120
MAILBOX_AUDIO_MAX_MB=25
MAILBOX_DRY_RUN=true
MAILBOX_MIN_PHONE_CONFIDENCE=0.85
MAILBOX_MIN_DAMAGE_CONFIDENCE=0.85

# HUK-Rueckrufservice: Live erst nach abgeschlossenem Dry Run BEIDE Schalter umstellen.
HUK_AUTOMATION_ENABLED=false
HUK_FORM_URL=https://www.huk.de/hukinfo/af/form.html?formname=/rueckruf/rueckrufservice
HUK_BROWSER_HEADLESS=true
HUK_BROWSER_TIMEOUT_MS=30000

# OCR
# Windows-Beispiel: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_MIN_CONFIDENCE=60
OCR_MIN_TEXT_LENGTH=20

# Uploads
UPLOAD_FOLDER=storage/uploads
MAX_UPLOAD_MB=25

# Offene Selbstregistrierung unter /auth/register (legt je Registrierung einen neuen Mandanten
# an). Standard: aus - Benutzer per `flask create-user --email ... --company ...` anlegen.
REGISTRATION_ENABLED=false

# Sessions
# In Produktion (HTTPS) auf true setzen, damit das Session-Cookie nur ueber HTTPS gesendet wird.
SESSION_COOKIE_SECURE=false

# Deployment / URL-Aufloesung fuer nginx-Checks
PUBLIC_HOST=
# Auch Basis fuer Links in E-Mails (Passwort-Reset), z. B. https://app.example.de
PUBLIC_URL=

# E-Mail-Versand (Passwort-Reset). Ohne SMTP_HOST, MAIL_FROM und PUBLIC_URL werden keine
# Reset-Mails verschickt (fail-closed).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
MAIL_FROM=
PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=1800
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3
